# Copy to .env locally; never commit secrets.
HOST=127.0.0.1
PORT=8787
# Required when binding a public/network interface. Never ship this token in an app bundle.
SERVICE_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,tauri://localhost,https://localhost
AMAP_WEB_SERVICE_KEY=
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
# An HTTPS endpoint implementing the chat-completions JSON protocol; configure explicitly.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
