# Copy to .env locally; never commit secrets.
HOST=127.0.0.1
PORT=8787
# Required when binding a public/network interface. Never ship this token in an app bundle.
SERVICE_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,tauri://localhost,https://localhost
AMAP_WEB_SERVICE_KEY=
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
# Optional server-managed DeepSeek connection. Set all three values together.
# Use only the current model IDs: deepseek-flash or deepseek-v4-pro.
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash
AI_API_KEY=
# Required to save provider credentials from the app. Generate at least 24
# random characters and keep it only on the trusted service. Do not enable
# this file-backed store for Render Free unless external persistence exists.
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_DATA_DIR=./data
ALLOW_LOCAL_AI_ENDPOINTS=false
# Exact trusted origins, comma separated. Required even when local endpoints
# are enabled. Docker-to-host Ollama can use an origin such as
# http://host.docker.internal:11434/v1.
AI_ALLOWED_LOCAL_ENDPOINTS=
