{
  "name": "warmsip",
  "version": "0.2.0-beta.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:bundle": "node scripts/check-bundle.mjs",
    "server:dev": "tsx server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist-server/server/index.js",
    "brand": "node scripts/brand.mjs",
    "tauri": "tauri",
    "android:sync": "npm run build && cap sync android",
    "harmony:sync": "node scripts/harmony-sync.mjs",
    "live:check": "node scripts/live-integration.mjs",
    "checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/share": "8.0.3",
    "@earendil-works/pi-ai": "1.5.0",
    "@fastify/cors": "11.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.1.0"
  }
}
